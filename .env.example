# Server-only OpenAI credential. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Deployed Google Apps Script web-app URL and matching Script Property.
GOOGLE_APPS_SCRIPT_LEAD_WEBHOOK_URL=
BRANDOPS_LEAD_WEBHOOK_SECRET=

# Dedicated bearer token used only by Hermes to submit social post drafts.
HERMES_WEBHOOK_TOKEN=

# LinkedIn personal-profile OAuth configuration.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CONNECT_TOKEN=
LINKEDIN_REDIRECT_URI=https://www.brandops.site/api/linkedin/oauth/callback
